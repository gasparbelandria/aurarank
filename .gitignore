# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
*.pem
*.md
!README.md

# OS
.DS_Store
Thumbs.db

# editors
.vscode/settings.json
.idea/
*.suo
*.swp
*.swo

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# env files — never commit secrets
.env
.env.*

# database — schema lives here, not committed (run db/schema.sql manually in Supabase)
/db/

# turbopack cache
.turbo/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
